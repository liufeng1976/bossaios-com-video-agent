{
  "name": "bossai-video-agent-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "BossAI Video Agent bilingual public-source Freemium desktop application",
  "author": "BossAI",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "39.8.9",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.bossai.videoagent",
    "productName": "BossAI Video Agent",
    "copyright": "Copyright © 2026 BossAI",
    "asar": true,
    "compression": "store",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "preload.js",
        "to": "desktop/preload.js"
      },
      {
        "from": "../ui/dist",
        "to": "ui",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "BossAI Video Engine.exe",
          "server.py",
          "bossai_os_bridge.py",
          "qwen_adapter.py",
          "cosyvoice_adapter.py",
          "cosyvoice_worker.py",
          "musetalk_adapter.py",
          "requirements.txt"
        ]
      },
      {
        "from": "../customer-product-metadata.json",
        "to": "metadata/product.json"
      },
      {
        "from": "../customer-third-party-notices.json",
        "to": "legal/third-party-notices.json"
      },
      {
        "from": "../../EULA.md",
        "to": "legal/EULA.md"
      },
      {
        "from": "../../LICENSE",
        "to": "legal/SOURCE-LICENSE.txt"
      },
      {
        "from": "../../LICENSE-HISTORICAL-MIT.md",
        "to": "legal/HISTORICAL-MIT-LICENSE.md"
      },
      {
        "from": "../../COMMERCIAL_LICENSE.md",
        "to": "legal/COMMERCIAL-LICENSE.md"
      },
      {
        "from": "../../TERMS.md",
        "to": "legal/TERMS.md"
      },
      {
        "from": "../../PRIVACY.md",
        "to": "legal/PRIVACY.md"
      },
      {
        "from": "../../INSTALL.md",
        "to": "legal/INSTALL.md"
      },
      {
        "from": "../runtime-installers",
        "to": "runtime-installers",
        "filter": [
          "install-python310.ps1",
          "install-qwen.ps1",
          "install-cosyvoice2.ps1",
          "install-musetalk.ps1",
          "install-whisper.ps1",
          "migrate-runtime-storage.ps1",
          "musetalk-constraints.txt",
          "musetalk-windows-requirements.txt",
          "cosyvoice-windows-requirements.txt",
          "runtime-source-lock.json",
          "whisper-windows-requirements.txt"
        ]
      },
      {
        "from": "../legal/capture-python-runtime-notices.py",
        "to": "legal/capture-python-runtime-notices.py"
      },
      {
        "from": "../first-party-assets",
        "to": "first-party-assets",
        "filter": [
          "**/*",
          "!README.md"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.svg",
      "target": [
        "nsis"
      ],
      "executableName": "BossAI Video Agent",
      "artifactName": "BossAI-Video-Agent-${version}-Setup.${ext}"
    },
    "nsis": {
      "useZip": true,
      "differentialPackage": false,
      "perMachine": false,
      "allowElevation": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BossAI Video Agent",
      "uninstallDisplayName": "BossAI Video Agent"
    }
  }
}
