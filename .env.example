# Local storage. Leave blank to use the per-user default.
BOSSAI_VIDEO_DATA_ROOT=
BOSSAI_VIDEO_RUNTIME_ROOT=
BOSSAI_VIDEO_RUNTIME_SUPPORT_ROOT=
BOSSAI_VIDEO_RESOURCES_ROOT=

# Bind only to a local interface during development.
BOSSAI_VIDEO_HOST=127.0.0.1
BOSSAI_VIDEO_PORT=8765

# BossAI OS bridge. Obtain a token from your own secured BossAI OS installation.
# Never commit a real value.
BOSSAI_OS_BASE_URL=
BOSSAI_OS_DESKTOP_TOKEN=

# Optional local model/runtime locations. Download models separately under their
# upstream licenses; no model weight belongs in this repository.
BOSSAI_QWEN_MODEL=
BOSSAI_QWEN_PYTHON=
BOSSAI_COSYVOICE_ROOT=
BOSSAI_COSYVOICE_MODEL_DIR=
BOSSAI_COSYVOICE_PYTHON=
BOSSAI_MUSETALK_ROOT=
BOSSAI_MUSETALK_PYTHON=
BOSSAI_FFMPEG_BIN=

# Generate fresh, high-entropy local-control and shutdown values for every install.
BOSSAI_VIDEO_LOCAL_CONTROL_TOKEN=
BOSSAI_VIDEO_SHUTDOWN_TOKEN=
